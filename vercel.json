{ 
    "version": 2, 
    "rewrites": [
        { 
            "source": "/(.*)", 
            "destination": "/api"     
        }
    ] ,
    "headers": [
        { 
            "source": "/(.*)",
            "headers": [{"key": "Cache-Control", "value": "s-maxage=600, stale-while-revalidate=3600"}] }
      ]

}